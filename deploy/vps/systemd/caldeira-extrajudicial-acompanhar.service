# Instalado por deploy/vps/instalar_vps.sh em /etc/systemd/system/. Nao editar la: editar aqui e rodar atualizar.sh.
[Unit]
Description=Caldeira - Extrajudicial: acompanhamento das notificacoes (diario 8h30)
After=network-online.target
Wants=network-online.target
# modulo ainda nao instalado: a rotina e pulada (nao conta como falha)
ConditionPathExists=/opt/caldeira/app/EXTRAJUDICIAL/main.py
OnFailure=caldeira-alerta@%n.service

[Service]
Type=oneshot
User=caldeira
Group=caldeira
WorkingDirectory=/opt/caldeira/app
Environment=PYTHONIOENCODING=utf-8 PYTHONUTF8=1 TZ=America/Porto_Velho
ExecStart=/opt/caldeira/app/.venv/bin/python EXTRAJUDICIAL/main.py acompanhar --enviar
StandardOutput=append:/opt/caldeira/app/logs/extrajudicial_acompanhar.log
StandardError=inherit
TimeoutStartSec=3h
Nice=5
