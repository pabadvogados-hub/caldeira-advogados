# Instalado por deploy/vps/instalar_vps.sh em /etc/systemd/system/. Horario de Rondonia (America/Porto_Velho).
[Unit]
Description=Caldeira - agenda: Financeiro: fechamento do mes anterior (dia 5, 8h)

[Timer]
OnCalendar=*-*-05 08:00:00 America/Porto_Velho
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
