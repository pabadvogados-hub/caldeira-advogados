# Instalado por deploy/vps/instalar_vps.sh em /etc/systemd/system/. Nao editar la: editar aqui e rodar atualizar.sh.
[Unit]
Description=Caldeira - Controladoria: relatorio quinzenal aos clientes, so gera (dias 1 e 16)
After=network-online.target
Wants=network-online.target
# modulo ainda nao instalado: a rotina e pulada (nao conta como falha)
ConditionPathExists=/opt/caldeira/app/CONTROLADORIA/main.py
OnFailure=caldeira-alerta@%n.service

[Service]
Type=oneshot
User=caldeira
Group=caldeira
WorkingDirectory=/opt/caldeira/app
Environment=PYTHONIOENCODING=utf-8 PYTHONUTF8=1 TZ=America/Porto_Velho
ExecStart=/opt/caldeira/app/.venv/bin/python CONTROLADORIA/main.py relatorio-clientes --dias 15
StandardOutput=append:/opt/caldeira/app/logs/controladoria_relatorio_clientes.log
StandardError=inherit
TimeoutStartSec=3h
Nice=5
