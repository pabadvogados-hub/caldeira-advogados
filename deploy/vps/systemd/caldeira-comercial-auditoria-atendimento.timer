# Instalado por deploy/vps/instalar_vps.sh em /etc/systemd/system/. Horario de Rondonia (America/Porto_Velho).
[Unit]
Description=Caldeira - agenda: Comercial: auditoria do atendimento (sexta 15h)

[Timer]
OnCalendar=Fri *-*-* 15:00:00 America/Porto_Velho
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
