# Instalado por deploy/vps/instalar_vps.sh em /etc/systemd/system/. Nao editar la: editar aqui e rodar atualizar.sh.
[Unit]
Description=Caldeira - Contratacao: assinaturas no ZapSign e cobranca de documentos (9h, 13h, 17h)
After=network-online.target
Wants=network-online.target
# modulo ainda nao instalado: a rotina e pulada (nao conta como falha)
ConditionPathExists=/opt/caldeira/app/CONTRATACAO/main.py
OnFailure=caldeira-alerta@%n.service

[Service]
Type=oneshot
User=caldeira
Group=caldeira
WorkingDirectory=/opt/caldeira/app
Environment=PYTHONIOENCODING=utf-8 PYTHONUTF8=1 TZ=America/Porto_Velho
ExecStart=/opt/caldeira/app/.venv/bin/python CONTRATACAO/main.py acompanhar --enviar
StandardOutput=append:/opt/caldeira/app/logs/contratacao_acompanhar.log
StandardError=inherit
TimeoutStartSec=3h
Nice=5
