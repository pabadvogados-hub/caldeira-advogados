# Instalado por deploy/vps/instalar_vps.sh em /etc/systemd/system/. Nao editar la: editar aqui e rodar atualizar.sh.
[Unit]
Description=Caldeira - Comercial: resultado das campanhas Meta Ads (diario 7h)
After=network-online.target
Wants=network-online.target
# modulo ainda nao instalado: a rotina e pulada (nao conta como falha)
ConditionPathExists=/opt/caldeira/app/COMERCIAL/main.py
OnFailure=caldeira-alerta@%n.service

[Service]
Type=oneshot
User=caldeira
Group=caldeira
WorkingDirectory=/opt/caldeira/app
Environment=PYTHONIOENCODING=utf-8 PYTHONUTF8=1 TZ=America/Porto_Velho
ExecStart=/opt/caldeira/app/.venv/bin/python COMERCIAL/main.py meta-ads --dias 1
StandardOutput=append:/opt/caldeira/app/logs/comercial_meta_ads.log
StandardError=inherit
TimeoutStartSec=3h
Nice=5
