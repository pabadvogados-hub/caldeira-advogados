# Instalado por deploy/vps/instalar_vps.sh em /etc/systemd/system/. Nao editar la: editar aqui e rodar atualizar.sh.
[Unit]
Description=Caldeira - Gestao: pauta da semana (segunda 7h)
After=network-online.target
Wants=network-online.target
# modulo ainda nao instalado: a rotina e pulada (nao conta como falha)
ConditionPathExists=/opt/caldeira/app/GESTAO/main.py
OnFailure=caldeira-alerta@%n.service

[Service]
Type=oneshot
User=caldeira
Group=caldeira
WorkingDirectory=/opt/caldeira/app
Environment=PYTHONIOENCODING=utf-8 PYTHONUTF8=1 TZ=America/Porto_Velho
ExecStart=/opt/caldeira/app/.venv/bin/python GESTAO/main.py pauta
StandardOutput=append:/opt/caldeira/app/logs/gestao_pauta.log
StandardError=inherit
TimeoutStartSec=3h
Nice=5
