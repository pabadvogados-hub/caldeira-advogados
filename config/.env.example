# Copie para config/.env e preencha. NUNCA versionar o .env.
# Sem uma credencial, a etapa correspondente e pulada (modo seguro): nada sai do escritorio.

# IA (obrigatoria) - conta Anthropic do escritorio
ANTHROPIC_API_KEY=
# Modelos (opcional): triagem juridica e extracao de dados
MODELO_TRIAGEM=claude-opus-5
MODELO_EXTRACAO=claude-sonnet-5

# Onde ficam as pastas dos clientes (servidor interno ou pasta sincronizada do Drive)
# ex.: \\SERVIDOR\CLIENTES   ou   Z:\CLIENTES   ou   G:\Meu Drive\CLIENTES
PASTA_CLIENTES_RAIZ=

# ZapSign - assinatura digital (Configuracoes > API no painel do ZapSign)
ZAPSIGN_API_TOKEN=

# Atende Direito - WhatsApp com o cliente
ATENDE_DIREITO_TOKEN=
NOME_ESCRITORIO=Caldeira Advogados Associados

# ADVBOX - cadastro de cliente/processo e tarefas
ADVBOX_API_TOKEN=
# nome (ou parte) do tipo de processo e da fase inicial no ADVBOX do escritorio
ADVBOX_TIPO_PROCESSO=
ADVBOX_FASE_INICIAL=

# Asaas - cobranca de honorarios
ASAAS_API_TOKEN=

# Conversao para PDF: se o Word nao estiver instalado, caminho do LibreOffice
SOFFICE_PATH=
# OCR de documento escaneado (opcional): caminho do tesseract.exe
TESSERACT_CMD=
