# Instalado por deploy/vps/instalar_vps.sh em /etc/systemd/system/. Horario de Rondonia (America/Porto_Velho).
[Unit]
Description=Caldeira - agenda: Controladoria: varredura de publicacoes e andamentos (diario 7h30)

[Timer]
OnCalendar=*-*-* 07:30:00 America/Porto_Velho
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
